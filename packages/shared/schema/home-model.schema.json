{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/HomeModel",
  "$defs": {
    "HomeModel": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "building": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "footprint": {
              "$ref": "#/$defs/Polygon"
            },
            "roofThickness": {
              "$ref": "#/$defs/PositiveDimension"
            },
            "roof": {
              "$ref": "#/$defs/Roof"
            },
            "northBearing": {
              "$ref": "#/$defs/Bearing"
            },
            "magneticDeclination": {
              "$ref": "#/$defs/Bearing"
            },
            "finishes": {
              "type": "object",
              "properties": {
                "facade": {
                  "$ref": "#/$defs/FinishUse"
                },
                "roof": {
                  "$ref": "#/$defs/FinishUse"
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["id", "name", "footprint", "roofThickness"],
          "additionalProperties": false
        },
        "terrain": {
          "type": "object",
          "properties": {
            "groundElevation": {
              "$ref": "#/$defs/Dimension"
            },
            "bottomElevation": {
              "$ref": "#/$defs/Dimension"
            },
            "patches": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/$defs/Id"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "outline": {
                    "$ref": "#/$defs/Polygon"
                  },
                  "holes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Polygon"
                    }
                  },
                  "elevation": {
                    "$ref": "#/$defs/Dimension"
                  },
                  "slope": {
                    "$ref": "#/$defs/Slope"
                  }
                },
                "required": ["id", "name", "outline", "elevation"],
                "additionalProperties": false
              }
            }
          },
          "required": ["groundElevation", "bottomElevation", "patches"],
          "additionalProperties": false
        },
        "levels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "elevation": {
                "$ref": "#/$defs/Dimension"
              },
              "height": {
                "$ref": "#/$defs/PositiveDimension"
              },
              "slabThickness": {
                "$ref": "#/$defs/PositiveDimension"
              }
            },
            "required": ["id", "name", "elevation", "height", "slabThickness"],
            "additionalProperties": false
          }
        },
        "apartments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "levelIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                }
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "entrances": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Entrance"
                }
              }
            },
            "required": ["id", "name", "levelIds"],
            "additionalProperties": false
          }
        },
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "levelId": {
                "$ref": "#/$defs/Id"
              },
              "apartmentId": {
                "$ref": "#/$defs/Id"
              },
              "outline": {
                "$ref": "#/$defs/Polygon"
              },
              "finishes": {
                "type": "object",
                "properties": {
                  "floor": {
                    "$ref": "#/$defs/FinishUse"
                  },
                  "walls": {
                    "$ref": "#/$defs/FinishUse"
                  },
                  "ceiling": {
                    "$ref": "#/$defs/FinishUse"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["id", "name", "levelId", "outline"],
            "additionalProperties": false
          }
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "levelId": {
                "$ref": "#/$defs/Id"
              },
              "apartmentId": {
                "$ref": "#/$defs/Id"
              },
              "kind": {
                "type": "string",
                "enum": ["exterior", "interior"]
              },
              "start": {
                "$ref": "#/$defs/Point"
              },
              "end": {
                "$ref": "#/$defs/Point"
              },
              "thickness": {
                "$ref": "#/$defs/PositiveDimension"
              },
              "height": {
                "$ref": "#/$defs/PositiveDimension"
              }
            },
            "required": ["id", "levelId", "kind", "start", "end", "thickness", "height"],
            "additionalProperties": false
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "typeId": {
                "$ref": "#/$defs/TypeId"
              },
              "wallId": {
                "$ref": "#/$defs/Id"
              },
              "type": {
                "type": "string",
                "enum": ["door", "window", "french-door", "garage-door"]
              },
              "offset": {
                "$ref": "#/$defs/NonNegativeDimension"
              },
              "width": {
                "$ref": "#/$defs/PositiveDimension"
              },
              "height": {
                "$ref": "#/$defs/PositiveDimension"
              },
              "sill": {
                "$ref": "#/$defs/NonNegativeDimension"
              }
            },
            "required": [
              "id",
              "name",
              "typeId",
              "wallId",
              "type",
              "offset",
              "width",
              "height",
              "sill"
            ],
            "additionalProperties": false
          }
        },
        "outdoorAreas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "enum": ["garden", "driveway", "patio", "path", "road", "gravel", "embankment"]
              },
              "ownerApartmentId": {
                "$ref": "#/$defs/Id"
              },
              "outline": {
                "$ref": "#/$defs/Polygon"
              },
              "elevation": {
                "$ref": "#/$defs/Dimension"
              },
              "slope": {
                "$ref": "#/$defs/Slope"
              },
              "finish": {
                "$ref": "#/$defs/FinishUse"
              }
            },
            "required": ["id", "name", "kind", "outline", "elevation"],
            "additionalProperties": false
          }
        },
        "outbuildings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Outbuilding"
          }
        },
        "stairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stair"
          }
        },
        "fences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fence"
          }
        },
        "ceilings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ceiling"
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "name",
        "building",
        "terrain",
        "levels",
        "apartments",
        "rooms",
        "walls",
        "openings",
        "outdoorAreas"
      ],
      "additionalProperties": false,
      "title": "my-home home model",
      "description": "A building with levels, apartments, rooms, walls, openings, terrain and outdoor areas. Units are metres; Y-up; ground level is y = 0."
    },
    "Id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "Polygon": {
      "minItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Point"
      },
      "description": "A simple polygon on the plan, at least 3 points."
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/Dimension"
        },
        "z": {
          "$ref": "#/$defs/Dimension"
        }
      },
      "required": ["x", "z"],
      "additionalProperties": false,
      "description": "A plan point (x east, z south) in metres."
    },
    "Dimension": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/DimensionSource"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["value", "source"],
      "additionalProperties": false,
      "description": "A value in metres with provenance."
    },
    "DimensionSource": {
      "type": "string",
      "enum": ["mock", "estimated-from-photo", "measured", "geodata"],
      "description": "Where a dimension value comes from."
    },
    "PositiveDimension": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source": {
          "$ref": "#/$defs/DimensionSource"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["value", "source"],
      "additionalProperties": false,
      "description": "A strictly positive value in metres with provenance."
    },
    "Roof": {
      "oneOf": [
        {
          "$ref": "#/$defs/FlatRoof"
        },
        {
          "$ref": "#/$defs/GableRoof"
        }
      ]
    },
    "FlatRoof": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "flat"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "GableRoof": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gable"
        },
        "ridgeAxis": {
          "type": "string",
          "enum": ["x", "z"]
        },
        "pitch": {
          "$ref": "#/$defs/Pitch"
        },
        "kneeWallHeight": {
          "$ref": "#/$defs/NonNegativeDimension"
        },
        "overhang": {
          "$ref": "#/$defs/NonNegativeDimension"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoofWindow"
          }
        }
      },
      "required": ["type", "ridgeAxis", "pitch", "kneeWallHeight", "overhang"],
      "additionalProperties": false
    },
    "Pitch": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 80
        },
        "source": {
          "$ref": "#/$defs/DimensionSource"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["value", "source"],
      "additionalProperties": false,
      "description": "A roof pitch in degrees (0 to 80) with provenance."
    },
    "NonNegativeDimension": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/DimensionSource"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["value", "source"],
      "additionalProperties": false,
      "description": "A non-negative value in metres with provenance."
    },
    "RoofWindow": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "typeId": {
          "$ref": "#/$defs/TypeId"
        },
        "side": {
          "type": "string",
          "enum": ["min", "max"]
        },
        "offset": {
          "$ref": "#/$defs/NonNegativeDimension"
        },
        "fromEave": {
          "$ref": "#/$defs/NonNegativeDimension"
        },
        "width": {
          "$ref": "#/$defs/PositiveDimension"
        },
        "length": {
          "$ref": "#/$defs/PositiveDimension"
        }
      },
      "required": ["id", "name", "typeId", "side", "offset", "fromEave", "width", "length"],
      "additionalProperties": false
    },
    "TypeId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
      "description": "A piece type in the catalogue, e.g. \"window.casement\"."
    },
    "Bearing": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "source": {
          "$ref": "#/$defs/DimensionSource"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["value", "source"],
      "additionalProperties": false,
      "description": "An angle in degrees with provenance."
    },
    "FinishUse": {
      "type": "object",
      "properties": {
        "finish": {
          "$ref": "#/$defs/FinishId"
        },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "rotation": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 90
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/DimensionSource"
        },
        "photos": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["finish", "source"],
      "additionalProperties": false,
      "description": "A finish of the library chosen for a surface."
    },
    "FinishId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
      "description": "A finish in the library, e.g. \"wood.oak-laminate\"."
    },
    "Slope": {
      "type": "object",
      "properties": {
        "towards": {
          "type": "string",
          "enum": ["+x", "-x", "+z", "-z"]
        },
        "lowElevation": {
          "$ref": "#/$defs/Dimension"
        }
      },
      "required": ["towards", "lowElevation"],
      "additionalProperties": false,
      "description": "A surface falling linearly across its bounding box."
    },
    "Entrance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "roomId": {
          "$ref": "#/$defs/Id"
        },
        "viaId": {
          "$ref": "#/$defs/Id"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": ["id", "name", "roomId", "viaId"],
      "additionalProperties": false
    },
    "Outbuilding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": ["garage", "carport", "shed", "porch", "compost"]
        },
        "footprint": {
          "$ref": "#/$defs/Polygon"
        },
        "floorElevation": {
          "$ref": "#/$defs/Dimension"
        },
        "height": {
          "$ref": "#/$defs/PositiveDimension"
        },
        "wallThickness": {
          "$ref": "#/$defs/PositiveDimension"
        },
        "roofThickness": {
          "$ref": "#/$defs/PositiveDimension"
        },
        "openEdges": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutbuildingOpening"
          }
        },
        "finish": {
          "$ref": "#/$defs/FinishUse"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "footprint",
        "floorElevation",
        "height",
        "wallThickness",
        "roofThickness"
      ],
      "additionalProperties": false
    },
    "OutbuildingOpening": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "typeId": {
          "$ref": "#/$defs/TypeId"
        },
        "type": {
          "type": "string",
          "enum": ["door", "window", "french-door", "garage-door"]
        },
        "edge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "$ref": "#/$defs/NonNegativeDimension"
        },
        "width": {
          "$ref": "#/$defs/PositiveDimension"
        },
        "height": {
          "$ref": "#/$defs/PositiveDimension"
        },
        "sill": {
          "$ref": "#/$defs/NonNegativeDimension"
        }
      },
      "required": ["id", "name", "typeId", "type", "edge", "offset", "width", "height", "sill"],
      "additionalProperties": false
    },
    "Stair": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "levelId": {
          "$ref": "#/$defs/Id"
        },
        "toLevelId": {
          "$ref": "#/$defs/Id"
        },
        "apartmentId": {
          "$ref": "#/$defs/Id"
        },
        "path": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "width": {
          "$ref": "#/$defs/PositiveDimension"
        },
        "finish": {
          "$ref": "#/$defs/FinishUse"
        }
      },
      "required": ["id", "name", "levelId", "toLevelId", "path", "width"],
      "additionalProperties": false
    },
    "Fence": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": ["chain-link", "privacy", "trellis", "gate"]
        },
        "typeId": {
          "$ref": "#/$defs/TypeId"
        },
        "path": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "elevation": {
          "$ref": "#/$defs/Dimension"
        },
        "endElevation": {
          "$ref": "#/$defs/Dimension"
        },
        "height": {
          "$ref": "#/$defs/PositiveDimension"
        }
      },
      "required": ["id", "name", "kind", "path", "elevation", "height"],
      "additionalProperties": false
    },
    "Ceiling": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "levelId": {
          "$ref": "#/$defs/Id"
        },
        "apartmentId": {
          "$ref": "#/$defs/Id"
        },
        "outline": {
          "$ref": "#/$defs/Polygon"
        },
        "height": {
          "$ref": "#/$defs/PositiveDimension"
        }
      },
      "required": ["id", "name", "levelId", "outline", "height"],
      "additionalProperties": false
    }
  }
}
