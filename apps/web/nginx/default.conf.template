server {
    # IPv4 only, so the image also starts on hosts with IPv6 disabled.
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    # Level 6, not nginx's default 1: the main chunk goes out about 16% smaller (546 kB to 459 kB).
    # Cloudflare caches the assets, so nginx compresses each file rarely.
    gzip_comp_level 6;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        # Photo uploads: phone photos are several MB (the api's own limit is PHOTO_MAX_UPLOAD_BYTES).
        client_max_body_size 32m;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The web app manifest (apps/web/public); revalidated like index.html.
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # SPA fallback; index.html is always revalidated.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
