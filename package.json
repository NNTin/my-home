{
  "name": "my-home",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @my-home/api --filter @my-home/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check:bundle": "node tools/check-bundle.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @my-home/api db:generate",
    "db:migrate": "pnpm --filter @my-home/api db:migrate",
    "db:seed": "pnpm --filter @my-home/api db:seed",
    "schema:generate": "pnpm --filter @my-home/shared schema:generate",
    "finishes:fetch": "pnpm --filter @my-home/shared exec tsx ../../tools/finishes/fetch.mjs fetch",
    "finishes:manifest": "pnpm --filter @my-home/shared exec tsx ../../tools/finishes/fetch.mjs manifest",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  }
}
