# Copy to .env and adjust. Every variable is optional.

# api
# Leave DATABASE_URL unset to use PGlite (in-process Postgres stored under PGLITE_DIR).
# DATABASE_URL=postgres://myhome:myhome@localhost:5432/myhome
PGLITE_DIR=.data/pglite
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
MIGRATE_ON_START=true
SEED_ON_START=true
# Home file seeded on start (default: data/homes/mock-home.json)
# SEED_FILE=../../data/homes/mock-home.json

# web (Vite dev server proxy target for /api)
API_URL=http://localhost:3000
